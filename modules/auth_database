from modules.database import (
    get_connection
)


def create_user(
    name,
    email,
    mobile_number,
    barangay_id,
    hashed_password
):

    conn = get_connection()
    cur = conn.cursor()

    cur.execute("""
        INSERT INTO users (
            name,
            email,
            mobile_number,
            barangay_id,
            password
        )
        VALUES (%s, %s, %s, %s, %s)
        RETURNING id
    """, (
        name,
        email,
        mobile_number,
        barangay_id,
        hashed_password
    ))

    user_id = cur.fetchone()[0]

    conn.commit()

    cur.close()
    conn.close()

    return user_id


def get_user_by_email(email):

    conn = get_connection()
    cur = conn.cursor()

    cur.execute("""
        SELECT
            id,
            name,
            email,
            mobile_number,
            barangay_id,
            password
        FROM users
        WHERE email = %s
    """, (email,))

    row = cur.fetchone()

    cur.close()
    conn.close()

    if not row:
        return None

    return {
        "id": row[0],
        "name": row[1],
        "email": row[2],
        "mobile_number": row[3],
        "barangay_id": row[4],
        "password": row[5],
    }